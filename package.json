{
  "name": "memecoinsniper-root",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Multi-Chain Memecoin Hunting & Trading Intelligence Engine",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:engine": "pnpm --filter @memesniper/engine run dev",
    "dev:web": "pnpm --filter @memesniper/web run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "keywords": [
    "memecoin",
    "solana",
    "bsc",
    "base",
    "trading-terminal",
    "smart-wallet",
    "hunting-engine"
  ],
  "author": "Operator",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
