# ==============================================================================
# PERSONAL MULTI-CHAIN MEMECOIN HUNTING ENGINE - CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001

# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Telegram Bot Alert Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_MIN_SCORE=80

# Solana Chain Settings (Mainnet)
# Free RPCs: https://api.mainnet-beta.solana.com or Alchemy/Helius/QuickNode free tiers
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_ENABLED=true

# BSC Chain Settings (Binance Smart Chain Mainnet - Chain ID 56)
# Free RPCs: https://binance.llamarpc.com or https://bsc-dataseed.binance.org
BSC_RPC_URL=https://binance.llamarpc.com
BSC_WS_URL=wss://bsc-rpc.publicnode.com
BSC_ENABLED=true

# Base Chain Settings (Coinbase Base Mainnet - Chain ID 8453)
# Free RPCs: https://mainnet.base.org or https://base.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
BASE_WS_URL=wss://base-rpc.publicnode.com
BASE_ENABLED=true

# Engine & Radar Filter Thresholds
MIN_LIQUIDITY_USD=2000
MAX_TOKEN_AGE_MINUTES=1440
MIN_OPPORTUNITY_SCORE=70
ALERT_DEDUPLICATION_WINDOW_MINUTES=30

# Web Dashboard (Next.js) Settings
NEXT_PUBLIC_ENGINE_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
